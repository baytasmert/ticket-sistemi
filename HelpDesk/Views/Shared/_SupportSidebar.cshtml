<div class="col-md-3 mb-4">
    <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
        <div class="card-header border-0" style="background: linear-gradient(135deg, #0dcaf0 0%, #0284c7 100%);">
            <h5 class="mb-0 text-white"><i class="bi bi-headset me-2"></i>Destek Menü</h5>
        </div>
        <div class="list-group list-group-flush">
            <a asp-controller="Support" asp-action="Dashboard"
               class="list-group-item list-group-item-action d-flex align-items-center gap-2
                      @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-controller="Support" asp-action="Index"
               class="list-group-item list-group-item-action d-flex align-items-center gap-2
                      @(ViewContext.RouteData.Values["action"]?.ToString() is "Index" or "Details" ? "active" : "")">
                <i class="bi bi-ticket-detailed"></i> Tüm Talepler
            </a>
            <a asp-controller="Support" asp-action="AssignedToMe"
               class="list-group-item list-group-item-action d-flex align-items-center gap-2
                      @(ViewContext.RouteData.Values["action"]?.ToString() == "AssignedToMe" ? "active" : "")">
                <i class="bi bi-person-check"></i> Bana Atanan
            </a>
        </div>
    </div>
</div>
