@model ErrorViewModel

@{
    ViewData["Title"] = "Hata";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div style="font-size: 5rem; color: #dc3545; margin-bottom: 20px;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h1 class="display-4 fw-bold mb-3">Hata Oluştu</h1>
            <p class="lead mb-4">Bir hata meydana geldi. Lütfen daha sonra tekrar deneyiniz.</p>

            @if (Model?.ShowRequestId == true)
            {
                <div class="alert alert-light border">
                    <p><strong>Request ID:</strong></p>
                    <p class="font-monospace small">@Model.RequestId</p>
                </div>
            }

            <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg">
                <i class="bi bi-house"></i> Ana Sayfaya Dön
            </a>
        </div>
    </div>
</div>
