@model RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header border-0 text-white text-center py-4 bg-gradient">
                <i class="bi bi-person-plus" style="font-size: 2.5rem;"></i>
                <h3 class="fw-bold mb-0 mt-2">Kayıt Ol</h3>
                <p class="mb-0 small opacity-75">Ücretsiz müşteri hesabı oluşturun</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="alert alert-info d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <div class="small">
                        <strong>Müşteri Kaydı.</strong>
                        Destek ekibi üyesiyseniz <a href="/staff/login" class="alert-link">personel girişini</a> kullanın.
                    </div>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="AdSoyad" class="form-label fw-semibold">
                            <i class="bi bi-person me-1 text-muted"></i>@Html.DisplayNameFor(m => m.AdSoyad)
                        </label>
                        <input asp-for="AdSoyad" class="form-control" placeholder="Adınız ve soyadınız" autofocus />
                        <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-1 text-muted"></i>@Html.DisplayNameFor(m => m.Email)
                        </label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefon" class="form-label fw-semibold">
                            <i class="bi bi-telephone me-1 text-muted"></i>@Html.DisplayNameFor(m => m.Telefon)
                        </label>
                        <input asp-for="Telefon" class="form-control" placeholder="5xx xxx xx xx" />
                        <span asp-validation-for="Telefon" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">
                                <i class="bi bi-lock me-1 text-muted"></i>@Html.DisplayNameFor(m => m.Password)
                            </label>
                            <input asp-for="Password" class="form-control" placeholder="En az 8 karakter" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock-fill me-1 text-muted"></i>@Html.DisplayNameFor(m => m.ConfirmPassword)
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifreyi tekrar girin" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-text mb-3">
                        <i class="bi bi-shield-check me-1"></i>
                        Şifre en az 8 karakter olmalı; büyük/küçük harf, rakam ve özel karakter içermelidir.
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                        <i class="bi bi-person-plus me-1"></i>Kayıt Ol
                    </button>
                </form>

                <hr class="my-4" />

                <p class="text-center mb-0">
                    Hesabın var mı? <a asp-action="Login" class="fw-semibold text-decoration-none">Giriş Yap</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
