@model LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header border-0 text-white text-center py-4 bg-gradient">
                <i class="bi bi-box-arrow-in-right" style="font-size: 2.5rem;"></i>
                <h3 class="fw-bold mb-0 mt-2">Giriş Yap</h3>
                <p class="mb-0 small opacity-75">Hesabınıza erişmek için giriş yapın</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">
                            <i class="bi bi-envelope me-1 text-muted"></i>@Html.DisplayNameFor(m => m.Email)
                        </label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="ornek@email.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">
                            <i class="bi bi-lock me-1 text-muted"></i>@Html.DisplayNameFor(m => m.Password)
                        </label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="Şifreniz" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe"></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                    </button>
                </form>

                <hr class="my-4" />

                <p class="text-center mb-2">
                    Hesabın yok mu? <a asp-action="Register" class="fw-semibold text-decoration-none">Kayıt Ol</a>
                </p>
                <p class="text-center text-muted small mb-0">
                    <i class="bi bi-person-gear me-1"></i>
                    Destek ekibi misiniz? <a href="/staff/login" class="text-decoration-none">Personel Girişi</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
