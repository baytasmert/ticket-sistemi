@model HelpDesk.ViewModels.TicketCreateViewModel
@{
    ViewData["Title"] = "Yeni Destek Talebi";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Taleplerime Dön
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header border-0 text-white py-4 bg-gradient">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni Destek Talebi</h4>
                    <p class="mb-0 small opacity-75">Sorununuzu bize iletin, en kısa sürede yanıtlayalım</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Baslik" class="form-label fw-semibold"></label>
                            <input asp-for="Baslik" class="form-control" placeholder="Sorununuzu kısaca özetleyin..." />
                            <span asp-validation-for="Baslik" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                                <select asp-for="CategoryId" asp-items="Model.Kategoriler" class="form-select">
                                    <option value="">-- Kategori seçin --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                <div class="form-text">Talebinizi doğru ekibe yönlendirir.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Oncelik" class="form-label fw-semibold"></label>
                                <select asp-for="Oncelik" asp-items="Model.OncelikSecenekleri" class="form-select"></select>
                                <span asp-validation-for="Oncelik" class="text-danger small"></span>
                                <div class="form-text">Aciliyete göre yanıt süremiz değişir.</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Aciklama" class="form-label fw-semibold"></label>
                            <textarea asp-for="Aciklama" class="form-control" rows="8"
                                      placeholder="Sorununuzu detaylı bir şekilde açıklayın... (ne zaman oluştu, hangi adımları denediniz?)"></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i> Talep Oluştur
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
