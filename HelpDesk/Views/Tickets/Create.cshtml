@model HelpDesk.ViewModels.TicketCreateViewModel
@{
    ViewData["Title"] = "Yeni Destek Talebi";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">Yeni Destek Talebi Oluştur</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Baslik" class="form-label fw-semibold"></label>
                            <input asp-for="Baslik" class="form-control" placeholder="Sorununuzu kısaca özetleyin..." />
                            <span asp-validation-for="Baslik" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                                <select asp-for="CategoryId" asp-items="Model.Kategoriler" class="form-select">
                                    <option value="">-- Kategori seçin --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Oncelik" class="form-label fw-semibold"></label>
                                <select asp-for="Oncelik" asp-items="Model.OncelikSecenekleri" class="form-select"></select>
                                <span asp-validation-for="Oncelik" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Aciklama" class="form-label fw-semibold"></label>
                            <textarea asp-for="Aciklama" class="form-control" rows="8"
                                      placeholder="Sorununuzu detaylı bir şekilde açıklayın..."></textarea>
                            <span asp-validation-for="Aciklama" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Talep Oluştur</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
