    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Çözümlenen</h5>
                <p class="card-text display-4">-</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Kapalı Talepler</h5>
                <p class="card-text display-4">-</p>
