@{
    ViewData["Title"] = "Destek Paneli - Dashboard";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="alert alert-info" role="alert">
    <h5>Destek Paneli</h5>
    <p>Bu sayfa destek ekibi ve admin tarafından ticket yönetimi için kullanılacaktır.</p>
    <p><strong>Kişi 3</strong> tarafından geliştirilmektedir.</p>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Toplam Talepler</h5>
                <p class="card-text display-4">-</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Açık Talepler</h5>
