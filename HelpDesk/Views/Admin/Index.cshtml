@model List<UserListViewModel>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Sidebar -->
        @await Html.PartialAsync("_AdminSidebar")

        <!-- Main Content -->
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>@ViewData["Title"]</h2>
                <a asp-action="CreateUser" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Yeni Kullanıcı Ekle
                </a>
            </div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<hr />

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Toplam Kullanıcı</h5>
                <p class="card-text">@ViewBag.Stats["ToplamKullanici"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h5 class="card-title">Admin</h5>
                <p class="card-text">@ViewBag.Stats["AdminSayisi"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Destek Temsilcisi</h5>
                <p class="card-text">@ViewBag.Stats["SupportAgentSayisi"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Müşteri</h5>
                <p class="card-text">@ViewBag.Stats["CustomerSayisi"]</p>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-6">
            <input type="text" name="search" class="form-control" placeholder="Email veya ad ara..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary w-100">Ara</button>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">Temizle</a>
        </div>
    </form>
</div>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Ad Soyad</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.AdSoyad</td>
                <td>@user.Email</td>
                <td>
                    <span class="badge bg-info">@user.Rol</span>
                </td>
                <td>
                    @if (user.AktifMi)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>
                    <a asp-action="EditUser" asp-route-userId="@user.Id" class="btn btn-sm btn-info">
                        <i class="bi bi-pencil"></i> Düzenle
                    </a>
                    <a asp-action="EditRole" asp-route-userId="@user.Id" class="btn btn-sm btn-primary">
                        Rol Değiştir
                    </a>
                    <form asp-action="ToggleActive" asp-route-userId="@user.Id" method="post" style="display: inline;">
                        @if (user.AktifMi)
                        {
                            <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Bu kullanıcıyı pasif yapmak istediğinize emin misiniz?')">
                                Pasifleştir
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Bu kullanıcıyı aktif yapmak istediğinize emin misiniz?')">
                                Aktifleştir
                            </button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

        </div>
    </div>
</div>
