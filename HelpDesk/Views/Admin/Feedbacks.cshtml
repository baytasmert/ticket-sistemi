@model List<HelpDesk.Models.Feedback>

@{
    ViewData["Title"] = "Geri Bildirimler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <span class="badge bg-info">@Model.Count toplam</span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Kategori</th>
                <th>Mesaj</th>
                <th>Email</th>
                <th>Tarih</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">Geri bildirim bulunmamaktadır.</td>
                </tr>
            }
            @foreach (var feedback in Model)
            {
                <tr class="@(feedback.Okundu ? "" : "table-light")">
                    <td>
                        @if (feedback.Kategori == "Geri Bildirim")
                        {
                            <span class="badge bg-info">@feedback.Kategori</span>
                        }
                        else if (feedback.Kategori == "İyileştirme Önerisi")
                        {
                            <span class="badge bg-success">@feedback.Kategori</span>
                        }
                        else if (feedback.Kategori == "Şikayet")
                        {
                            <span class="badge bg-danger">@feedback.Kategori</span>
                        }
                    </td>
                    <td>
                        <small>@(feedback.Mesaj.Length > 100 ? feedback.Mesaj.Substring(0, 100) + "..." : feedback.Mesaj)</small>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(feedback.Email))
                        {
                            <a href="mailto:@feedback.Email">@feedback.Email</a>
                        }
                        else
                        {
                            <em class="text-muted">Belirtilmedi</em>
                        }
                    </td>
                    <td>
                        <small>@feedback.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </td>
                    <td>
                        @if (feedback.Okundu)
                        {
                            <span class="badge bg-success">Okundu</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Okunmadı</span>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#feedbackModal_@feedback.Id">
                            Detay
                        </button>
                        <form asp-action="MarkAsRead" asp-route-feedbackId="@feedback.Id" method="post" style="display: inline;">
                            @if (feedback.Okundu)
                            {
                                <button type="submit" class="btn btn-sm btn-secondary">Okunmadı İşaretle</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-success">Okundu İşaretle</button>
                            }
                        </form>
                        <form asp-action="DeleteFeedback" asp-route-feedbackId="@feedback.Id" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</button>
                        </form>
                    </td>
                </tr>

                <!-- Modal -->
                <div class="modal fade" id="feedbackModal_@feedback.Id" tabindex="-1">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Geri Bildirim Detayları</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p><strong>Kategori:</strong> @feedback.Kategori</p>
                                <p><strong>Tarih:</strong> @feedback.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</p>
                                @if (!string.IsNullOrEmpty(feedback.Email))
                                {
                                    <p><strong>Email:</strong> <a href="mailto:@feedback.Email">@feedback.Email</a></p>
                                }
                                <p><strong>Mesaj:</strong></p>
                                <div class="alert alert-light">
                                    @feedback.Mesaj
                                </div>
                                <p><strong>Durum:</strong> @(feedback.Okundu ? "Okundu" : "Okunmadı")</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
</div>
