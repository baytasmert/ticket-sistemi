@model EditUserViewModel

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <h2>@ViewData["Title"]</h2>
        <hr />

        <form asp-action="EditUser" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="AdSoyad" class="form-label"></label>
                <input asp-for="AdSoyad" class="form-control" />
                <span asp-validation-for="AdSoyad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" readonly />
                <small class="text-muted">Email değiştirilemez.</small>
            </div>

            <div class="mb-3">
                <label asp-for="Telefon" class="form-label"></label>
                <input asp-for="Telefon" class="form-control" />
                <span asp-validation-for="Telefon" class="text-danger"></span>
            </div>

            @if (ViewBag.UserRole == "SupportAgent" || ViewBag.UserRole == "Admin")
            {
                <div class="mb-3">
                    <label asp-for="Departman" class="form-label"></label>
                    <input asp-for="Departman" class="form-control" />
                    <small class="text-muted">Destek personeli departmanı.</small>
                </div>
            }

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Güncelle</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
