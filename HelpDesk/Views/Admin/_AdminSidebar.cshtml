<div class="col-md-3">
    <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
        <div class="card-header bg-primary text-white border-0">
            <h5 class="mb-0"><i class="bi bi-gear"></i> Admin Menü</h5>
        </div>
        <div class="list-group list-group-flush">
            <a asp-action="Dashboard" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="bi bi-people"></i> Kullanıcılar
            </a>
            <a asp-action="Categories" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() is "Categories" or "CreateCategory" ? "active" : "")">
                <i class="bi bi-tags"></i> Kategoriler
            </a>
            <a asp-action="AllTickets" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "AllTickets" ? "active" : "")">
                <i class="bi bi-ticket-detailed"></i> Tüm Talepler
            </a>
        </div>
    </div>
</div>
