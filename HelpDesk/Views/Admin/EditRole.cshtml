@{
    ViewData["Title"] = "Rol Düzenle";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <h2>@ViewData["Title"]</h2>
        <hr />

        <div class="card">
            <div class="card-body">
                <p><strong>Email:</strong> @ViewBag.UserEmail</p>
                <p><strong>Mevcut Rol:</strong> <span class="badge bg-info">@ViewBag.CurrentRole</span></p>

                <form asp-action="EditRole" method="post" class="mt-3">
                    <input type="hidden" name="userId" value="@ViewBag.UserId" />

                    <div class="mb-3">
                        <label for="newRole" class="form-label">Yeni Rol</label>
                        <select name="newRole" id="newRole" class="form-select" required>
                            <option value="">-- Bir rol seçin --</option>
                            @foreach (var role in ViewBag.AvailableRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-action="Index" class="btn btn-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
